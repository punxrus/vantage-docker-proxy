# Copy to .env and fill in. Referenced from config/*.yml as ${NAME}.

# Run Vantage as this user/group (owner of ./data on the host).
PUID=1000
PGID=1000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# MySpeed on 192.168.0.10:5216 (was hard-coded in glance.yml)
MYSPEED_PASSWORD=

# glance-agent on 192.168.0.10 (same value as AGENT_TOKEN in remote/.env)
AGENT_TOKEN_10=

# Optional: GitHub token for the releases widget (raises rate limits)
GITHUB_TOKEN=

# Family Google Calendar ID (the part before %40group.calendar.google.com)
FAMILY_CALENDAR_ID=
